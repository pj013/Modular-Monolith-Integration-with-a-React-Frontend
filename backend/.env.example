# Copy this file to `.env` (gitignored) for your own reference, or export these
# directly in your shell / IDE run configuration before starting the app.
# Spring Boot does NOT read .env files automatically - see README for how to load them.

SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Optional - defaults to http://localhost:5173 if not set
CORS_ALLOWED_ORIGIN=http://localhost:5173
